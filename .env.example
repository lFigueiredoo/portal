# ── Appwrite Auth (provedor oficial de identidade) ──────────────────
# Endpoint do projeto Appwrite (Cloud ou self-hosted), ex.:
# https://nyc.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_ENDPOINT=

# Project ID do painel do Appwrite (Settings → General).
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# API key do Appwrite (escopos mínimos: criar sessões + ler a tabela de
# perfis). NUNCA exposta ao navegador — usada apenas no servidor.
APPWRITE_API_KEY=

# ── Banco do Appwrite (permissões do Portal) ────────────────────────
# Database + tabela `user_profiles` (ver README, seção "Setup do Appwrite").
APPWRITE_DATABASE_ID=
APPWRITE_USER_PROFILES_TABLE_ID=user_profiles