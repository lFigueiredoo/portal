# ── Appwrite Auth (provedor oficial de identidade) ──────────────────
# Endpoint do projeto Appwrite (Cloud ou self-hosted), ex.:
# https://nyc.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_ENDPOINT=

# Project ID do painel do Appwrite (Settings → General).
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# API key do Appwrite (escopos mínimos: criar sessões + ler a tabela de
# perfis). NUNCA exposta ao navegador — usada apenas no servidor.
APPWRITE_API_KEY=

# ── Banco do Appwrite (permissões do Portal) ────────────────────────
# Database + tabela `user_profiles` (ver README, seção "Setup do Appwrite").
APPWRITE_DATABASE_ID=
APPWRITE_USER_PROFILES_TABLE_ID=user_profiles

# ── Setup automatizado (npm run setup:appwrite) ─────────────────────
# Cria database, tabela, colunas e o primeiro administrador pela API.
# O script também aceita os valores acima (NEXT_PUBLIC_APPWRITE_ENDPOINT,
# NEXT_PUBLIC_APPWRITE_PROJECT_ID, APPWRITE_DATABASE_ID,
# APPWRITE_USER_PROFILES_TABLE_ID) — só preencha estes se quiser usar
# valores diferentes dos do portal. API key precisa dos escopos:
# users.read, users.write, tablesdb.read, tablesdb.write, sessions.write.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=

# Conta do primeiro administrador (o script cria o usuário Appwrite e o
# perfil ADMIN em user_profiles). Use apenas localmente / com cuidado —
# de preferência informe ADMIN_PASSWORD por ambiente, não em arquivo.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=